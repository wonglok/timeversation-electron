    "js-video-url-parser": "^0.5.1",
    "lifecycle-utils": "^3.1.1",
    "lowdb": "^7.0.1",
    "markdown-it": "^14.1.1",
    "node-llama-cpp": "^3.19.0",
    "openai": "^7.1.0",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "readline": "^1.3.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
