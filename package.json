    "@gonetone/get-youtube-id-by-url": "^2.0.0",
    "@lancedb/lancedb": "^0.31.0",
    "@lobehub/icons": "^5.15.0",
    "@openai/codex-sdk": "^0.145.0",
    "@types/three": "^0.185.1",
    "birpc": "^4.0.0",
    "classnames": "^2.5.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
